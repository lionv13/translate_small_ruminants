if __name__ == "__main__":
    categories = extract_data(file_path)
    if not categories or not any(cat["questions"] for cat in categories):
        raise RuntimeError("No categories/questions extracted from Meat Word file")

    print("✅ Ready to process translations.")
    print("Total categories loaded:", len(categories))
    print("First category:", categories[0]["category_name"] if categories else "NONE")
    print("Total questions loaded:", sum(len(cat["questions"]) for cat in categories))

    for cat in categories:
        for q in cat["questions"]:
            if q["number"] in ["7a", "7b", "8a", "8b", "10a", "10b", "92a", "92b"]:
                print("\n--------------------------------")
                print("Question:", q["number"])
                print("Text:", q["question"])
                print("Answers:", q["answers"])
                print("--------------------------------")

    print("⚠️ Verify the APITEST Meat questionnaire slug before running. Configured:", questionnaire_url)
    driver = webdriver.Chrome()
    inloggen()
    driver.get(questionnaire_url)
    process_items(driver, categories)
    print("🎉 Completed the full Dutch translation processing on APITEST.")
