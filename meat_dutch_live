# =============================================================

def extract_data(file_path):
    """Read the Dutch Word survey, including Word auto-numbered question 1."""
    doc = docx.Document(file_path)
    blocks = []
    for element in doc.element.body:
        if element.tag.endswith('}p'):
            blocks.append(docx.text.paragraph.Paragraph(element, doc))
        elif element.tag.endswith('}tbl'):
            blocks.append(Table(element, doc))

    categories = []
    category = None
    current = None
    question_counter = 0
    category_pattern = re.compile(r'^(~|[A-M])\.\s*(.+)$')
    numbered_pattern = re.compile(r'^(\d+[a-zA-Z]?|[IVXLCDM]+)\.\s*(.+)$')
    bullet_pattern = re.compile(r'^[□○●•▪]\s*')
    instruction_pattern = re.compile(r'^(?:Selecteer één optie|Kruis aan wat van toepassing is)\.?$', re.I)
    redirect_pattern = re.compile(r'\b(?:ga naar|ga rechtstreeks naar|sla .* over|indien .* gekozen wordt|als .* gekozen wordt)\b', re.I)
    placeholder_pattern = re.compile(r'^[.\s…_\-]+$')

    def finish_question():
        nonlocal current
        if current is not None and category is not None:
            for key in ('help_text', 'redirect'):
                current[key] = ' '.join(current[key]).strip()
            category['questions'].append(current)
        current = None

    for block in blocks:
        if isinstance(block, Table):
            if current is None:
                continue
            rows = [[cell.text.strip() for cell in row.cells] for row in block.rows]
            if rows:
                current['answers'] = [c for c in rows[0][1:] if c]
                current['statements'] = [row[0] for row in rows[1:] if row and row[0]]
            continue

        value = re.sub(r'\s+', ' ', block.text).strip()
        if not value:
            continue
        value = re.sub(r'\s*\(verplicht\)', '', value, flags=re.I).strip()
        size = max((r.font.size.pt for r in block.runs if r.font.size), default=None)
        cat_match = category_pattern.match(value)
        if cat_match and (size or 0) >= 16:
            finish_question()
            category = {'category_name': cat_match.group(2).strip(), 'questions': []}
            categories.append(category)
            question_counter = 0
            continue

        match = numbered_pattern.match(value)
        is_word_numbered = (block.style.name.startswith('List') and (size or 0) >= 14 and not bullet_pattern.match(value))
        is_question = category is not None and ((match and (size or 0) >= 14) or is_word_numbered)
        if is_question:
            finish_question()
            question_counter += 1
            number = match.group(1) if match else str(question_counter)
            qtext = match.group(2) if match else value
            current = {'question': qtext, 'number': number, 'answers': [], 'statements': [], 'help_text': [], 'redirect': []}
            continue
        if current is None or instruction_pattern.match(value) or placeholder_pattern.match(value):
            continue
        if bullet_pattern.match(value):
            answer = bullet_pattern.sub('', value).strip()
            if answer:
                current['answers'].append(answer)
            continue
        if redirect_pattern.search(value):
            current['redirect'].append(value)
        else:
            current['help_text'].append(value)

    finish_question()
    return categories


